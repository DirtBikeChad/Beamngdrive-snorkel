{
"scintilla_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "scintilla_mod",
    "slots": [
        ["type", "default", "description"],
        ["scintilla_snorkel_tube", "scintilla_snorkel_tube_small", "Snorkel"],
    ],
},

"scintilla_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"1. Small Snorkel (roof height, 2 m)",
        "value":180,
    },
    "slotType" : "scintilla_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_scintilla_small_v9", ["scintilla_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"scintilla_snorkel"},
        {"nodeWeight":2.0},
        ["snb", -0.81, -1.12, 0.72],
        ["snf", -0.9, -0.98, 0.79],
        ["snp", -0.9, -0.58, 0.87],
        ["snr", -0.89, -0.3, 1.2],
        ["sn1", -0.89, -0.3, 1.5],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.89, -0.3, 2.0],
        {"engineGroup":""},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //--tube structure: chain + skip-one braces (a node every ~0.5 m
        //keeps the flexbody binding sound; moderate spring/damp keeps the
        //structure numerically stable)--
        {"beamSpring":351000,"beamDamp":120},
        {"beamDeform":30000,"beamStrength":80000},
        ["snb","snf"],
        ["snf","snp"],
        ["snp","snr"],
        ["snr","sn1"],
        ["sn1","snh"],
        ["snb","snp"],
        ["snf","snr"],
        ["snp","sn1"],
        ["snr","snh"],
        ["snb","snr"],
        ["snf","sn1"],
        ["snb","snh"],
        //--attachment to the engine block--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":251000,"beamDamp":100},
        {"beamDeform":25000,"beamStrength":60000},
        {"breakGroup":"scintilla_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
        ["snf","e1l"],
        ["snp","e1r"],
        ["snp","e2r"],
        ["snp","e3r"],
        ["snp","e4r"],
        ["snp","e2l"],
        ["snr","e1r"],
        ["snr","e2r"],
        ["snr","e3r"],
        ["snr","e4r"],
        ["snr","e4l"],
        ["sn1","e1r"],
        ["sn1","e2r"],
        ["sn1","e3r"],
        ["sn1","e4r"],
        ["snh","e1r"],
        ["snh","e2r"],
        ["snh","e3r"],
        ["snh","e4r"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

