{
"covet_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "covet_mod",
    "slots": [
        ["type", "default", "description"],
        ["covet_snorkel_tube", "covet_snorkel_tube_small", "Snorkel"],
    ],
},

"covet_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"1. Small Snorkel (roof height, 2 m)",
        "value":180,
    },
    "slotType" : "covet_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_covet_small_v11", ["covet_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"covet_snorkel"},
        {"nodeWeight":1.2},
        ["snb", -0.64, -0.78, 0.75],
        ["snf", -0.7, -0.85, 0.85],
        ["snp", -0.7, -0.48, 0.95],
        ["snr", -0.69, -0.22, 1.35],
        ["sn1", -0.69, -0.22, 1.5],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.69, -0.22, 2.0],
        {"engineGroup":""},
        //invisible ladder rungs: the flexbody binder needs nodes forming
        //~90 degree angles near every vertex; a straight line of nodes
        //shears the mesh (official flexbodies docs)
        {"collision":false},
        ["snrb", -0.44, -0.22, 1.35],
        ["sn1b", -0.44, -0.22, 1.5],
        ["snhb", -0.44, -0.22, 2.0],
        {"collision":true},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //--ladder truss structure--
        {"beamSpring":351000,"beamDamp":120},
        {"beamDeform":30000,"beamStrength":80000},
        ["snb","snf"],
        ["snf","snp"],
        ["snp","snr"],
        ["snr","sn1"],
        ["sn1","snh"],
        ["snb","snp"],
        ["snf","snr"],
        ["snp","sn1"],
        ["snr","snh"],
        ["snb","snr"],
        ["snrb","sn1b"],
        ["sn1b","snhb"],
        ["snr","snrb"],
        ["sn1","sn1b"],
        ["snh","snhb"],
        ["snr","sn1b"],
        ["snrb","sn1"],
        ["sn1","snhb"],
        ["sn1b","snh"],
        ["snp","snrb"],
        ["snf","snrb"],
        //--attachment to the engine block--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":251000,"beamDamp":100},
        {"beamDeform":25000,"beamStrength":60000},
        {"breakGroup":"covet_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
