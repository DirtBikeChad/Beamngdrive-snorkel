{
"moonhawk_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "moonhawk_mod",
    "slots": [
        ["type", "default", "description"],
        ["moonhawk_snorkel_tube", "moonhawk_snorkel_tube_small", "Snorkel"],
    ],
},

"moonhawk_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"1. Small Snorkel (roof height, 2 m)",
        "value":180,
    },
    "slotType" : "moonhawk_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_moonhawk_small_v10", ["moonhawk_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"moonhawk_snorkel"},
        {"nodeWeight":1.2},
        ["snb", -0.86, -1.3, 0.85],
        ["snf", -0.95, -1.05, 0.92],
        ["snp", -0.95, -0.55, 1.02],
        ["snr", -0.94, -0.25, 1.4],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.94, -0.25, 2.0],
        {"engineGroup":""},
        //invisible ladder rungs: the flexbody binder needs nodes forming
        //~90 degree angles near every vertex; a straight line of nodes
        //shears the mesh (official flexbodies docs)
        {"collision":false},
        ["snrb", -0.69, -0.25, 1.4],
        ["snhb", -0.69, -0.25, 2.0],
        {"collision":true},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //--ladder truss structure--
        {"beamSpring":351000,"beamDamp":120},
        {"beamDeform":30000,"beamStrength":80000},
        ["snb","snf"],
        ["snf","snp"],
        ["snp","snr"],
        ["snr","snh"],
        ["snb","snp"],
        ["snf","snr"],
        ["snp","snh"],
        ["snb","snr"],
        ["snrb","snhb"],
        ["snr","snrb"],
        ["snh","snhb"],
        ["snr","snhb"],
        ["snrb","snh"],
        ["snp","snrb"],
        ["snf","snrb"],
        //--attachment to the engine block--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":251000,"beamDamp":100},
        {"beamDeform":25000,"beamStrength":60000},
        {"breakGroup":"moonhawk_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
        ["snf","e1l"],
        ["snp","e1r"],
        ["snp","e2r"],
        ["snp","e3r"],
        ["snp","e4r"],
        ["snp","e2l"],
        ["snr","e1r"],
        ["snr","e2r"],
        ["snr","e3r"],
        ["snr","e4r"],
        ["snr","e4l"],
        ["snh","e1r"],
        ["snh","e2r"],
        ["snh","e3r"],
        ["snh","e4r"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

