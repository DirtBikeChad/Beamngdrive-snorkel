{
"pickup_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "pickup_mod",
    "slots": [
        ["type", "default", "description"],
        ["pickup_snorkel_tube", "pickup_snorkel_tube_tall", "Snorkel"],
    ],
},

"pickup_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Small Snorkel (hood height)",
        "value":180,
    },
    "slotType" : "pickup_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_small", ["pickup_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"pickup_snorkel"},
        {"nodeWeight":1.4},
        ["snb", -0.90, -1.16, 0.97],
        ["snf", -0.99, -0.92, 1.05],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"nodeWeight":1.0},
        {"engineGroup":["engine_intake"]},
        ["snh", -0.99, -0.88, 1.30],
        {"engineGroup":""},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--tube structure (rigid triangle)--
        {"beamSpring":1301000,"beamDamp":300},
        {"beamDeform":40000,"beamStrength":90000},
        ["snb","snf"],
        ["snf","snh"],
        ["snb","snh"],
        //--attachment: rigid lock to the engine block so the tube cannot
        //resonate on its own (temporary until cab-node anchoring lands)--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":2601000,"beamDamp":400},
        {"beamDeform":60000,"beamStrength":130000},
        {"breakGroup":"pickup_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
        ["snf","e1l"],
        ["snh","e1r"],
        ["snh","e2r"],
        ["snh","e3r"],
        ["snh","e4r"],
        ["snh","e2l"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

