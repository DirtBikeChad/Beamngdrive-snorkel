{
"pickup_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "pickup_mod",
    "slots": [
        ["type", "default", "description"],
        ["pickup_snorkel_tube", "pickup_snorkel_tube_tall", "Snorkel"],
    ],
},

"pickup_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Small Snorkel (hood height)",
        "value":180,
    },
    "slotType" : "pickup_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_small", ["pickup_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"nodeWeight":0.6},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"pickup_snorkel"},
        ["snb", -0.90, -1.16, 0.97],
        ["snk", -0.995, -0.86, 1.04],
        ["snp", -0.995, -0.74, 1.08],
        ["snt", -0.995, -0.670, 1.24],
        //ram head opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.995, -0.834, 1.284],
        {"engineGroup":""},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--tube structure--
        {"beamSpring":801000,"beamDamp":250},
        {"beamDeform":32000,"beamStrength":64000},
        ["snb","snk"],
        ["snk","snp"],
        ["snp","snt"],
        ["snt","snh"],
        ["snb","snp"],
        ["snk","snt"],
        ["snp","snh"],
        ["snk","snh"],
        //--attachment to the engine block (rigid, like a real intake tract)--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":501000,"beamDamp":150},
        {"beamDeform":8000,"beamStrength":24000},
        {"breakGroup":"pickup_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snk","e1r"],
        ["snk","e2r"],
        ["snk","e3r"],
        ["snk","e4r"],
        ["snp","e3r"],
        ["snp","e4r"],
        ["snp","e3l"],
        ["snp","e4l"],
        ["snt","e3r"],
        ["snt","e4r"],
        ["snt","e3l"],
        ["snt","e4l"],
        ["snh","e3r"],
        ["snh","e4r"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

