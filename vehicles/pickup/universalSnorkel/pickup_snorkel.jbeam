{
"pickup_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "pickup_mod",
    "slots": [
        ["type", "default", "description"],
        ["pickup_snorkel_tube", "pickup_snorkel_tube_small", "Snorkel"],
    ],
},

"pickup_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"1. Small Snorkel (mirror height)",
        "value":180,
    },
    "slotType" : "pickup_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_small", ["pickup_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"pickup_snorkel"},
        {"nodeWeight":2.0},
        ["snb", -0.90, -1.16, 0.97],
        ["snf", -0.99, -0.92, 1.05],
        ["snp", -0.99, -0.86, 1.30],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.985, -0.73, 1.62],
        {"engineGroup":""},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //--tube structure (fully triangulated)--
        //spring/damp deliberately moderate: too-stiff beams on light nodes
        //go numerically unstable and break the part on spawn
        {"beamSpring":351000,"beamDamp":120},
        {"beamDeform":30000,"beamStrength":80000},
        ["snb","snf"],
        ["snf","snp"],
        ["snp","snh"],
        ["snb","snp"],
        ["snf","snh"],
        ["snb","snh"],
        //--attachment to the engine block--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":251000,"beamDamp":100},
        {"beamDeform":25000,"beamStrength":60000},
        {"breakGroup":"pickup_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
        ["snf","e1l"],
        ["snp","e1r"],
        ["snp","e2r"],
        ["snp","e3r"],
        ["snp","e4r"],
        ["snp","e2l"],
        ["snh","e1r"],
        ["snh","e2r"],
        ["snh","e3r"],
        ["snh","e4r"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

