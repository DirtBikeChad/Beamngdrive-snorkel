{
"hopper_snorkel_mount": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"Snorkel (Right A-Pillar)",
        "value":120,
    },
    "slotType" : "hopper_mod",
    "slots": [
        ["type", "default", "description"],
        ["hopper_snorkel_tube", "hopper_snorkel_tube_small", "Snorkel"],
    ],
},

"hopper_snorkel_tube_small": {
    "information":{
        "authors":"DirtBikeChad",
        "name":"1. Small Snorkel (roof height, 2 m)",
        "value":180,
    },
    "slotType" : "hopper_snorkel_tube",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["snorkel_hopper_small_v9", ["hopper_snorkel"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":true},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":"hopper_snorkel"},
        {"nodeWeight":2.0},
        ["snb", -0.75, -0.95, 1.0],
        ["snf", -0.84, -0.78, 1.08],
        ["snp", -0.84, -0.72, 1.28],
        ["snr", -0.83, -0.48, 1.75],
        //opening: this node is the functional air intake.
        //water at or above this point floods the engine.
        {"engineGroup":["engine_intake"]},
        ["snh", -0.83, -0.48, 2.0],
        {"engineGroup":""},
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //--tube structure: chain + skip-one braces (a node every ~0.5 m
        //keeps the flexbody binding sound; moderate spring/damp keeps the
        //structure numerically stable)--
        {"beamSpring":351000,"beamDamp":120},
        {"beamDeform":30000,"beamStrength":80000},
        ["snb","snf"],
        ["snf","snp"],
        ["snp","snr"],
        ["snr","snh"],
        ["snb","snp"],
        ["snf","snr"],
        ["snp","snh"],
        ["snb","snr"],
        //--attachment to the engine block--
        //optional: silently skipped on engines without the standard e1..e4 nodes
        {"beamSpring":251000,"beamDamp":100},
        {"beamDeform":25000,"beamStrength":60000},
        {"breakGroup":"hopper_snorkel_break"},
        {"optional":true},
        ["snb","e1r"],
        ["snb","e2r"],
        ["snb","e3r"],
        ["snb","e4r"],
        ["snb","e3l"],
        ["snf","e1r"],
        ["snf","e2r"],
        ["snf","e3r"],
        ["snf","e4r"],
        ["snf","e1l"],
        ["snp","e1r"],
        ["snp","e2r"],
        ["snp","e3r"],
        ["snp","e4r"],
        ["snp","e2l"],
        ["snr","e1r"],
        ["snr","e2r"],
        ["snr","e3r"],
        ["snr","e4r"],
        ["snr","e4l"],
        ["snh","e1r"],
        ["snh","e2r"],
        ["snh","e3r"],
        ["snh","e4r"],
        {"optional":false},
        {"breakGroup":""},
    ],
},

